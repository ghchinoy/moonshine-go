
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads/interactions.jsonl

# Native libmoonshine build output (see scripts/build-libmoonshine.sh);
# built locally from a moonshine checkout, not vendored/committed.
/.moonshine/

# Go build artifacts
/bin/
/dist/
bench/loadtest/loadtest
*.test
*.out
coverage.txt

# samples/ Go module build output and Python virtualenvs/bytecode
samples/*/moonshine-sample-*
samples/grpc-listen/grpc-listen
samples/go-cascade-faq/go-cascade-faq
samples/go-listen/go-listen
samples/**/.venv/
samples/**/__pycache__/
samples/**/*.pyc

# Downloaded model assets, in case `moonshine setup`/`transcribe`/`live` is
# ever pointed at a project-local --model-dir instead of the default cache.
/.moonshine-models/

# Credentials that should never end up in a public repo (e.g. a GCP service
# account key used for gs:// transcription input).
*-key.json
service-account*.json
credentials.json
.env

# OS / editor cruft
.DS_Store

# Local editor/agent-tool state, not project config
.serena/

# Benchmark test audio assets (fetched on demand via scripts/fetch-bench-assets.sh)
bench/testdata/

# Internal vision/landscape touchstone docs -- not part of the public repo
/docs/vision/
/docs/proposals/
/docs/blog/

# Stray tts default output if run from the repo root without -o
/out.wav
*.swp
*.swo
*~
.idea/
.vscode/
