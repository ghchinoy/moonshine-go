---
const { data } = Astro.locals.starlightRoute.entry;
const { hero } = data;
const quickstartCmd = 'moonshine setup --tts kokoro_af_heart && moonshine serve --transport ws --allow-actions';
---

{
  hero && (
    <section class="egm-hero">
      <div class="egm-hero-inner">
        <div class="egm-pillars">
          <span class="egm-badge egm-badge-blue">CGO_ENABLED=0 Pure Go</span>
          <span class="egm-badge egm-badge-orange">10 STT Languages &middot; 4 TTS Engines</span>
        </div>

        <h1 class="egm-display">
          On-device voice for Go.<br />
          Fast enough for the cascade.
        </h1>

        {hero.tagline && <p class="egm-lead">{hero.tagline}</p>}

        {hero.actions && hero.actions.length > 0 && (
          <div class="egm-actions">
            {hero.actions.map((action) => (
              <a
                href={action.link}
                class:list={[
                  'egm-btn',
                  action.variant === 'primary'
                    ? 'egm-btn-filled'
                    : action.variant === 'secondary'
                      ? 'egm-btn-outlined'
                      : 'egm-btn-text',
                ]}
              >
                <span>{action.text}</span>
                {action.variant === 'primary' && (
                  <svg viewBox="0 -960 960 960" aria-hidden="true" class="egm-btn-icon">
                    <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        )}

        <div class="egm-copy-wrap">
          <button
            type="button"
            class="egm-copybox"
            aria-label="Copy quickstart command"
            data-hero-copy={quickstartCmd}
          >
            <code class="egm-copy-code">{quickstartCmd}</code>
            <span class="egm-copy-action" aria-hidden="true">
              <span class="egm-copied-badge">Copied</span>
              <span class="egm-copy-icon">
                <svg class="icon-copy" viewBox="0 -960 960 960">
                  <path d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z" />
                </svg>
                <svg class="icon-check" viewBox="0 -960 960 960">
                  <path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z" />
                </svg>
              </span>
            </span>
          </button>
        </div>
      </div>
    </section>
  )
}

<script>
  const timers = new WeakMap<HTMLElement, number>();
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-hero-copy]')) {
    const label = button.getAttribute('aria-label') ?? '';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.heroCopy ?? '');
        button.classList.add('copied');
        button.setAttribute('aria-label', `${label} — Copied`);
        window.clearTimeout(timers.get(button));
        timers.set(
          button,
          window.setTimeout(() => {
            button.classList.remove('copied');
            button.setAttribute('aria-label', label);
          }, 1800)
        );
      } catch {
        // Ignore clipboard errors in non-secure contexts
      }
    });
  }
</script>

<style>
  .egm-hero {
    padding-block: clamp(48px, 7vw, 88px) clamp(36px, 5vw, 64px);
    border-block-end: 1px solid var(--md-sys-color-outline-variant);
    margin-block-end: 2rem;
  }

  .egm-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    max-inline-size: 920px;
    margin-inline: auto;
  }

  .egm-pillars {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .egm-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 9999px;
    font: var(--md-sys-typescale-label-md);
    letter-spacing: 0.02em;
  }

  .egm-badge-blue {
    background: var(--egm-color-elephant-container);
    color: var(--egm-color-elephant);
  }

  .egm-badge-orange {
    background: var(--egm-color-goldfish-container);
    color: var(--egm-color-goldfish);
  }

  .egm-display {
    font: var(--md-sys-typescale-display-lg);
    letter-spacing: var(--md-sys-typescale-display-lg-tracking);
    color: var(--md-sys-color-on-surface);
    text-wrap: balance;
    margin: 0;
  }

  .egm-lead {
    font: var(--md-sys-typescale-body-lg);
    color: var(--md-sys-color-on-surface-variant);
    max-inline-size: 56ch;
    text-wrap: balance;
    margin: 0;
  }

  .egm-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-block-start: 4px;
  }

  .egm-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 9999px;
    font: var(--md-sys-typescale-label-lg);
    text-decoration: none;
    transition: transform 0.12s ease, background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }

  .egm-btn-filled {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary) !important;
    border: 1px solid transparent;
  }

  .egm-btn-filled:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .egm-btn-outlined {
    background: transparent;
    color: var(--md-sys-color-on-surface) !important;
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  .egm-btn-outlined:hover {
    background: var(--md-sys-color-surface-container);
    border-color: var(--md-sys-color-outline);
  }

  .egm-btn-text {
    background: transparent;
    color: var(--md-sys-color-on-surface-variant) !important;
    padding-inline: 14px;
  }

  .egm-btn-text:hover {
    color: var(--md-sys-color-on-surface) !important;
    background: var(--md-sys-color-surface-container-low);
  }

  .egm-btn-icon {
    inline-size: 18px;
    block-size: 18px;
    fill: currentColor;
  }

  .egm-copy-wrap {
    inline-size: 100%;
    max-inline-size: 680px;
    margin-block-start: 6px;
  }

  .egm-copybox {
    inline-size: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px;
    border-radius: var(--md-sys-shape-corner-md);
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
    text-align: left;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .egm-copybox:hover {
    background: var(--md-sys-color-surface-container);
    border-color: var(--md-sys-color-outline);
  }

  .egm-copy-code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--md-sys-color-on-surface);
    background: transparent;
    padding: 0;
    overflow-x: auto;
    white-space: nowrap;
  }

  .egm-copy-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    color: var(--md-sys-color-on-surface-variant);
  }

  .egm-copied-badge {
    display: none;
    font: var(--md-sys-typescale-label-md);
    color: var(--egm-color-elephant);
  }

  .egm-copy-icon svg {
    inline-size: 18px;
    block-size: 18px;
    fill: currentColor;
  }

  .icon-check {
    display: none;
    color: var(--egm-color-elephant);
  }

  .egm-copybox.copied .egm-copied-badge,
  .egm-copybox.copied .icon-check {
    display: inline-block;
  }

  .egm-copybox.copied .icon-copy {
    display: none;
  }
</style>
