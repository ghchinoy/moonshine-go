---
import AudioSample from './AudioSample.astro';
import manifest from '../data/audio-manifest.json';

const speedupFactor = manifest.ttfa_comparison
  ? (manifest.ttfa_comparison.oneshot.ttfa_ms / manifest.ttfa_comparison.streaming.ttfa_ms).toFixed(1)
  : '3.8';
---

<div class="audio-showcase">
  <h3>TTS Voice Showcase (4 Open-Weight Engines: Kokoro, Piper, ZipVoice &amp; Phonon)</h3>
  <p class="showcase-lead">Moonshine unifies four open-weight TTS engines behind one streaming C/Go API: <strong>Kokoro 82M</strong> (sub-sentence prosody streaming), <strong>Piper</strong> (16 languages), <strong>ZipVoice</strong> (zero-shot voice cloning), and <strong>Phonon 31M</strong> (added in <code>v0.1.6</code> — Apache 2.0 streaming English on Kyutai's Mimi codec with 37 catalog voices). Hear real audio synthesized locally via <code>bin/moonshine tts</code>:</p>
  
  <div class="voices-grid">
    {manifest.voices.map((v) => (
      <AudioSample
        src={v.url}
        label={v.label}
        sublabel={v.id}
      />
    ))}
  </div>

  {manifest.ttfa_comparison && (
    <div class="ttfa-box">
      <h3>Streaming TTS Latency (One-Shot vs Sub-Sentence Streaming)</h3>
      <p class="showcase-lead">Comparing Time-to-First-Audio (TTFA) measured in <code>samples/go-embedded</code>:</p>
      <div class="comparison-grid">
        <AudioSample
          src={manifest.ttfa_comparison.oneshot.url}
          label="One-Shot Synthesis"
          sublabel={`TTFA: ${manifest.ttfa_comparison.oneshot.ttfa_ms}ms`}
        />
        <AudioSample
          src={manifest.ttfa_comparison.streaming.url}
          label="Streaming Synthesis (NewStream)"
          sublabel={`TTFA: ${manifest.ttfa_comparison.streaming.ttfa_ms}ms (${speedupFactor}x faster)`}
        />
      </div>
    </div>
  )}

  {manifest.stt_demo && (
    <div class="stt-demo-box">
      <h3>Speech-to-Text Demo</h3>
      <p class="showcase-lead">Source: <em>{manifest.stt_demo.title}</em> ({manifest.stt_demo.source})</p>
      <AudioSample
        src={manifest.stt_demo.url}
        label="Input Audio (6 seconds)"
      />
      <div class="transcript-box">
        <strong>Transcribed by Moonshine (tiny-en):</strong>
        <blockquote>"{manifest.stt_demo.transcript}"</blockquote>
      </div>
    </div>
  )}
</div>

<style>
  .audio-showcase {
    margin: 1.75rem 0;
  }
  .showcase-lead {
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: 1rem;
  }
  .voices-grid, .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .ttfa-box, .stt-demo-box {
    margin-top: 1.5rem;
    padding: 1.35rem;
    border: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container-low);
    border-radius: var(--md-sys-shape-corner-lg);
  }
  .ttfa-box h3, .stt-demo-box h3 {
    margin-top: 0;
  }
  .transcript-box {
    margin-top: 0.85rem;
    padding: 0.9rem 1.1rem;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-md);
  }
  .transcript-box blockquote {
    margin: 0.5rem 0 0 0;
    padding-left: 0.85rem;
    border-left: 3px solid var(--egm-color-elephant);
    background: transparent;
    font-style: italic;
  }
</style>
